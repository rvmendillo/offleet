{"a1":[{"k":"title","cap":"Is the Tree Symmetric?","say":"Let's solve Is the Tree Symmetric?, using the Mirrored Two Pointers approach.","card":{"title":"Is the Tree Symmetric?","sub":"Mirrored Two Pointers · Easy","pattern":"tree"}},{"k":"problem","cap":"Return true if the tree is a mirror image of itself around its center.","card":{"lines":["Return true if the tree is a mirror image of itself around its center."]}},{"k":"example","cap":"For example, with root = [1,2,2,3,4,4,3], the answer is true.","say":"For example, with root equals 1, 2, 2, 3, 4, 4, 3, the answer is true.","card":{"lines":["Input: root = [1,2,2,3,4,4,3]","Output: true"]}},{"k":"idea","cap":"Use two pointers, one walking the left half and one the right half in mirror order. The outer pair (left.left, right.right) and the inner pair (left.right, right.left) must match at every level.","card":{"pattern":"tree","name":"Trees"}},{"k":"trace","cap":"Let's walk through it with root = [1,2,2,3,4,4,3].","say":"Let's walk through it with root equals 1, 2, 2, 3, 4, 4, 3.","st":{"tree":{"nodes":[{"id":3,"v":"3","x":0,"y":2,"l":-1,"r":-1},{"id":1,"v":"2","x":1,"y":1,"l":3,"r":4},{"id":4,"v":"4","x":2,"y":2,"l":-1,"r":-1},{"id":0,"v":"1","x":3,"y":0,"l":1,"r":2},{"id":5,"v":"4","x":4,"y":2,"l":-1,"r":-1},{"id":2,"v":"2","x":5,"y":1,"l":5,"r":6},{"id":6,"v":"3","x":6,"y":2,"l":-1,"r":-1}],"p":[{"l":"a","id":1},{"l":"b","id":2}]}}},{"k":"step","cap":"Compare 2 with its mirror 2.","ln":{"python":5,"java":8},"st":{"tree":{"nodes":[{"id":3,"v":"3","x":0,"y":2,"l":-1,"r":-1},{"id":1,"v":"2","x":1,"y":1,"l":3,"r":4},{"id":4,"v":"4","x":2,"y":2,"l":-1,"r":-1},{"id":0,"v":"1","x":3,"y":0,"l":1,"r":2},{"id":5,"v":"4","x":4,"y":2,"l":-1,"r":-1},{"id":2,"v":"2","x":5,"y":1,"l":5,"r":6},{"id":6,"v":"3","x":6,"y":2,"l":-1,"r":-1}],"p":[{"l":"a","id":1},{"l":"b","id":2}]}}},{"k":"step","cap":"Compare 3 with its mirror 3.","ln":{"python":5,"java":8},"st":{"tree":{"nodes":[{"id":3,"v":"3","x":0,"y":2,"l":-1,"r":-1},{"id":1,"v":"2","x":1,"y":1,"l":3,"r":4},{"id":4,"v":"4","x":2,"y":2,"l":-1,"r":-1},{"id":0,"v":"1","x":3,"y":0,"l":1,"r":2},{"id":5,"v":"4","x":4,"y":2,"l":-1,"r":-1},{"id":2,"v":"2","x":5,"y":1,"l":5,"r":6},{"id":6,"v":"3","x":6,"y":2,"l":-1,"r":-1}],"p":[{"l":"a","id":3},{"l":"b","id":6}]}}},{"k":"step","cap":"Compare 4 with its mirror 4.","ln":{"python":5,"java":8},"st":{"tree":{"nodes":[{"id":3,"v":"3","x":0,"y":2,"l":-1,"r":-1},{"id":1,"v":"2","x":1,"y":1,"l":3,"r":4},{"id":4,"v":"4","x":2,"y":2,"l":-1,"r":-1},{"id":0,"v":"1","x":3,"y":0,"l":1,"r":2},{"id":5,"v":"4","x":4,"y":2,"l":-1,"r":-1},{"id":2,"v":"2","x":5,"y":1,"l":5,"r":6},{"id":6,"v":"3","x":6,"y":2,"l":-1,"r":-1}],"p":[{"l":"a","id":4},{"l":"b","id":5}]}}},{"k":"done","cap":"The answer is true.","st":{"tree":{"nodes":[{"id":3,"v":"3","x":0,"y":2,"l":-1,"r":-1},{"id":1,"v":"2","x":1,"y":1,"l":3,"r":4},{"id":4,"v":"4","x":2,"y":2,"l":-1,"r":-1},{"id":0,"v":"1","x":3,"y":0,"l":1,"r":2},{"id":5,"v":"4","x":4,"y":2,"l":-1,"r":-1},{"id":2,"v":"2","x":5,"y":1,"l":5,"r":6},{"id":6,"v":"3","x":6,"y":2,"l":-1,"r":-1}],"p":[{"l":"a","id":4},{"l":"b","id":5}]}}},{"k":"complexity","cap":"Time complexity is O(n) and extra space is O(h).","say":"Time complexity is O of n and extra space is O of h.","card":{"time":"O(n)","space":"O(h)"}},{"k":"outro","cap":"That's the Mirrored Two Pointers approach. Now try writing it yourself, in Java or Python!"}]}