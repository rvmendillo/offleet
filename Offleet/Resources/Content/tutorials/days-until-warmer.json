y","i":4}]}],"stacks":[{"n":"waiting days","v":["2","3","4"],"t":"stack"}],"out":{"n":"res","v":["1","1","0","0","0","0","0"]}}},{"k":"step","cap":"Day 4 (69°) waited 1 day for 72°.","say":"Day 4 (69 degrees ) waited 1 day for 72 degrees.","ln":{"python":6,"java":8},"st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":5}]}],"stacks":[{"n":"waiting days","v":["2","3"],"t":"stack"}],"out":{"n":"res","v":["1","1","0","0","1","0","0"]}}},{"k":"step","cap":"Day 3 (71°) waited 2 days for 72°.","say":"Day 3 (71 degrees ) waited 2 days for 72 degrees.","ln":{"python":6,"java":8},"st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":5}]}],"stacks":[{"n":"waiting days","v":["2"],"t":"stack"}],"out":{"n":"res","v":["1","1","0","2","1","0","0"]}}},{"k":"step","cap":"Day 5 (72°) starts waiting.","say":"Day 5 (72 degrees ) starts waiting.","ln":{"python":7,"java":10},"st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":5}]}],"stacks":[{"n":"waiting days","v":["2","5"],"t":"stack"}],"out":{"n":"res","v":["1","1","0","2","1","0","0"]}}},{"k":"step","cap":"Day 5 (72°) waited 1 day for 76°.","say":"Day 5 (72 degrees ) waited 1 day for 76 degrees.","ln":{"python":6,"java":8},"st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":6}]}],"stacks":[{"n":"waiting days","v":["2"],"t":"stack"}],"out":{"n":"res","v":["1","1","0","2","1","1","0"]}}},{"k":"step","cap":"Day 2 (75°) waited 4 days for 76°.","say":"Day 2 (75 degrees ) waited 4 days for 76 degrees.","ln":{"python":6,"java":8},"st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":6}]}],"stacks":[{"n":"waiting days","v":[],"t":"stack"}],"out":{"n":"res","v":["1","1","4","2","1","1","0"]}}},{"k":"step","cap":"Day 6 (76°) starts waiting.","say":"Day 6 (76 degrees ) starts waiting.","ln":{"python":7,"java":10},"st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":6}]}],"stacks":[{"n":"waiting days","v":["6"],"t":"stack"}],"out":{"n":"res","v":["1","1","4","2","1","1","0"]}}},{"k":"done","cap":"The answer is [1,1,4,2,1,1,0].","say":"The answer is 1, 1, 4, 2, 1, 1, 0.","st":{"arrays":[{"n":"temps","v":["73","74","75","71","69","72","76"],"p":[{"l":"today","i":6}]}],"stacks":[{"n":"waiting days","v":["6"],"t":"stack"}],"out":{"n":"res","v":["1","1","4","2","1","1","0"]}}},{"k":"complexity","cap":"Time complexity is O(n) and extra space is O(n). Every day is pushed once and popped at most once.","say":"Time complexity is O of n and extra space is O of n. Every day is pushed once and popped at most once.","card":{"time":"O(n)","space":"O(n)"}},{"k":"outro","cap":"That's the Monotonic Stack approach. Now try writing it yourself, in Java or Python!"}]}