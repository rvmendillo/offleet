l":"tail","id":8}]}}},{"k":"done","cap":"The answer is [7,0,8].","say":"The answer is 7, 0, 8.","st":{"vars":[{"k":"carry","v":"0"}],"linked":{"nodes":[{"id":0,"v":"2","nx":1,"row":0,"col":0,"dim":true},{"id":1,"v":"4","nx":2,"row":0,"col":1,"dim":true},{"id":2,"v":"3","nx":-1,"row":0,"col":2,"dim":false},{"id":3,"v":"5","nx":4,"row":1,"col":0,"dim":true},{"id":4,"v":"6","nx":5,"row":1,"col":1,"dim":true},{"id":5,"v":"4","nx":-1,"row":1,"col":2,"dim":false},{"id":6,"v":"0","nx":7,"row":2,"col":0,"dim":false},{"id":7,"v":"7","nx":8,"row":2,"col":1,"dim":false},{"id":8,"v":"0","nx":9,"row":2,"col":2,"dim":false},{"id":9,"v":"8","nx":-1,"row":2,"col":3,"dim":false}],"p":[{"l":"a","id":2},{"l":"b","id":5},{"l":"tail","id":8}]}}},{"k":"complexity","cap":"Time complexity is O(n + m) and extra space is O(1) extra.","say":"Time complexity is O of n plus m and extra space is O of one extra.","card":{"time":"O(n + m)","space":"O(1) extra"}},{"k":"outro","cap":"That's the Digit-by-Digit with Carry approach. Now try writing it yourself, in Java or Python!"}]}