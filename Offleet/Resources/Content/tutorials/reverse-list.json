{"a1":[{"k":"title","cap":"Reverse a Linked List","say":"Let's solve Reverse a Linked List, using the Two Pointers (prev and cur) approach.","card":{"title":"Reverse a Linked List","sub":"Two Pointers (prev & cur) · Easy","pattern":"two-pointers"}},{"k":"problem","cap":"Given the head of a singly linked list, reverse the list so the last node becomes the first, and return the new head.","card":{"lines":["Given the head of a singly linked list, reverse the list so the last node becomes the first, and return the new head."]}},{"k":"example","cap":"For example, with head = [1,2,3,4], the answer is [4,3,2,1].","say":"For example, with head equals 1, 2, 3, 4, the answer is 4, 3, 2, 1.","card":{"lines":["Input: head = [1,2,3,4]","Output: [4,3,2,1]"]}},{"k":"idea","cap":"Use two pointers: prev starts empty and cur starts at the head.","card":{"pattern":"two-pointers","name":"Two Pointers"}},{"k":"idea","cap":"At each node, remember the next node, flip cur.next to point back at prev, then slide both pointers one step forward. When cur falls off the end, prev is the new head.","card":{"pattern":"two-pointers","name":"Two Pointers"}},{"k":"trace","cap":"Let's walk through it with head = [1,2,3,4].","say":"Let's walk through it with head equals 1, 2, 3, 4.","st":{"linked":{"nodes":[{"id":0,"v":"1","nx":1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":2,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"cur","id":0}]}}},{"k":"step","cap":"prev starts empty and cur starts at the head.","ln":{"python":2,"java":3},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":2,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"cur","id":0}]}}},{"k":"step","cap":"Save the next node, 2, so we don't lose the rest.","ln":{"python":4,"java":5},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":2,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"cur","id":0},{"l":"next","id":1}]}}},{"k":"step","cap":"Flip node 1 to point back at nothing.","ln":{"python":5,"java":6},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":2,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"cur","id":0},{"l":"next","id":1}]}}},{"k":"step","cap":"Slide forward: prev is now 1, cur is 2.","ln":{"python":6,"java":7},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":2,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":0},{"l":"cur","id":1},{"l":"next","id":1}]}}},{"k":"step","cap":"Save the next node, 3, so we don't lose the rest.","ln":{"python":4,"java":5},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":2,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":0},{"l":"cur","id":1},{"l":"next","id":2}]}}},{"k":"step","cap":"Flip node 2 to point back at 1.","ln":{"python":5,"java":6},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":0},{"l":"cur","id":1},{"l":"next","id":2}]}}},{"k":"step","cap":"Slide forward: prev is now 2, cur is 3.","ln":{"python":6,"java":7},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":1},{"l":"cur","id":2},{"l":"next","id":2}]}}},{"k":"step","cap":"Save the next node, 4, so we don't lose the rest.","ln":{"python":4,"java":5},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":3,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":1},{"l":"cur","id":2},{"l":"next","id":3}]}}},{"k":"step","cap":"Flip node 3 to point back at 2.","ln":{"python":5,"java":6},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":1},{"l":"cur","id":2},{"l":"next","id":3}]}}},{"k":"step","cap":"Slide forward: prev is now 3, cur is 4.","ln":{"python":6,"java":7},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":2},{"l":"cur","id":3},{"l":"next","id":3}]}}},{"k":"step","cap":"Save the next node, nothing, so we don't lose the rest.","ln":{"python":4,"java":5},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":-1,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":2},{"l":"cur","id":3}]}}},{"k":"step","cap":"Flip node 4 to point back at 3.","ln":{"python":5,"java":6},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":2,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":2},{"l":"cur","id":3}]}}},{"k":"step","cap":"Slide forward: prev is now 4, and cur fell off the end.","ln":{"python":6,"java":7},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":2,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":3}]}}},{"k":"step","cap":"prev, node 4, is the new head.","ln":{"python":7,"java":9},"st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":2,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":3}]}}},{"k":"done","cap":"The answer is [4,3,2,1].","say":"The answer is 4, 3, 2, 1.","st":{"linked":{"nodes":[{"id":0,"v":"1","nx":-1,"row":0,"col":0,"dim":false},{"id":1,"v":"2","nx":0,"row":0,"col":1,"dim":false},{"id":2,"v":"3","nx":1,"row":0,"col":2,"dim":false},{"id":3,"v":"4","nx":2,"row":0,"col":3,"dim":false}],"p":[{"l":"prev","id":3}]}}},{"k":"complexity","cap":"Time complexity is O(n) and extra space is O(1).","say":"Time complexity is O of n and extra space is O of one.","card":{"time":"O(n)","space":"O(1)"}},{"k":"outro","cap":"That's the Two Pointers (prev & cur) approach. Now try writing it yourself, in Java or Python!","say":"That's the Two Pointers (prev and cur) approach. Now try writing it yourself, in Java or Python!"}]}